# Past2Pixel Environment Configuration
# Copy this file to .env and configure your environment-specific settings.

# Compute & Device Configuration
# Device override: 'auto', 'cpu', or 'cuda' (use 'auto' for automatic detection)
DEVICE=auto
NUM_WORKERS=0
SEED=42

# Storage & Model Checkpoints
CHECKPOINT_DIR=./checkpoints
DATA_DIR=./data
SESSIONS_STORAGE_DIR=./data/sessions

# Dataset Local Paths (Override if stored in custom directories)
VEDO_DATASET_DIR=./data/raw/VedoOCR
SANSKRIT_HINDI_DATASET_DIR=./data/raw/sanskrit_hindi_ocr_vqa
SYNTHETIC_DATA_DIR=./data/synthetic

# Model Defaults
INPUT_IMAGE_SIZE=256
DEFAULT_BATCH_SIZE=8
LEARNING_RATE=0.0002

# Authentication & Security
# WARNING: Change JWT_SECRET_KEY in production to a secure random string!
JWT_SECRET_KEY=change-this-to-a-super-secret-random-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Upload Security Restrictions
MAX_UPLOAD_SIZE_MB=15

# MongoDB Atlas Persistence Configuration
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
# If left empty, Past2Pixel gracefully falls back to local file-backed persistence.
MONGODB_URI=
MONGODB_DB_NAME=past2pixel

# OCR Engine Configuration
# Windows Tesseract executable path if not in system PATH
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Logging & Monitoring
LOG_LEVEL=INFO
